    {
      "parameters": {
        "jsCode": "// Normalize incoming quiz lead payload and generate a unique confirmation token\nconsole.log('Step1: received webhook payload');\n\nconst body = $json.body || $json;\nconst now = new Date().toISOString();\n\nconst email = (body.email || '').toLowerCase().trim();\nconst name = (body.name || '').trim();\nconst company = (body.company || '').trim();\nconst phone = (body.phone || '').trim();\nconst quizId = body.quizId || 'marketing-data-audit';\nconst variant = body.variant || 'a';\nconst totalScore = body.totalScore ?? 0;\nconst maxScore = body.maxScore ?? 25;\nconst heatLevel = body.heatLevel || 'cold';\nconst resultBucket = body.resultBucket || 'flying-blind';\nconst source = body.source || 'direct';\nconst timestamp = body.timestamp || now;\n\nif (!email) {\n  throw new Error('Step1: Missing email in payload — cannot proceed');\n}\n\n// Generate short unique token for reply matching\n// Format: ma-<timestamp-hex>-<random-hex>\nconst tsMs = Date.now().toString(16);\nconst rand = Math.random().toString(16).slice(2, 10);\nconst confirmToken = `ma-${tsMs}-${rand}`;\n\nconsole.log(`Step1: token generated ${confirmToken} for ${email} score=${totalScore}/${maxScore} tier=${resultBucket}`);\n\nreturn [{\n  json: {\n    email,\n    name,\n    company,\n    phone,\n    quizId,\n    variant,\n    totalScore,\n    maxScore,\n    heatLevel,\n    resultBucket,\n    source,\n    timestamp,\n    confirmToken,\n    receivedAt: now,\n    status: 'awaiting_confirmation'\n  }\n}];"
      },
      "id": "ma-node-04",
      "name": "Code — Normalize and Generate Token",
      "type": "n8n-nodes-base.code",
