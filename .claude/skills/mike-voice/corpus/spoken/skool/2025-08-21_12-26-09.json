: -0.2602572242418925, "compression_ratio": 12.5, "no_speech_prob": 3.8766104042131655e-12}, {"id": 57, "seek": 9150, "start": 91.5, "end": 93.5, "text": " Welcome to buildmytribe.ai", "tokens": [50365, 4027, 281, 1322, 2226, 83, 470, 650, 13, 1301, 50465], "temperature": 0, "avg_logprob": -0.13337318264708228, "compression_ratio": 1.7142857142857142, "no_speech_prob": 2.9626839176399855e-12}, {"id": 58, "seek": 9150, "start": 95.5, "end": 96.5, "text": " I'm getting hot.", "tokens": [50565, 286, 478, 1242, 2368, 13, 50615], "temperature": 0, "avg_logprob": -0.13337318264708228, "compression_ratio": 1.7142857142857142, "no_speech_prob": 2.9626839176399855e-12}, {"id": 59, "seek": 9150, "start": 98.5, "end": 99.5, "text": " Welcome to buildmytribe.ai", "tokens": [50715, 4027, 281, 1322, 2226, 83, 470, 650, 13, 1301, 50765], "temperature": 0, "avg_logprob": -0.13337318264708228, "compression_ratio": 1.7142857142857142, "no_speech_prob": 2.9626839176399855e-12}, {"id": 60, "seek": 9150, "start": 99.5, "end": 100.5, "text": " My name is Mike,", "tokens": [50765, 1222, 1315, 307, 6602, 11, 50815], "temperature": 0, "avg_logprob": -0.13337318264708228, "compression_ratio": 1.7142857142857142, "no_speech_prob": 2.9626839176399855e-12}, {"id": 61, "seek": 9150, "start": 100.5, "end": 102.5, "text": " and you're here because of one of two reasons.", "tokens": [50815, 293, 291, 434, 510, 570, 295, 472, 295, 732, 4112, 13, 50915], "temperature": 0, "avg_logprob": -0.13337318264708228, "compression_ratio": 1.7142857142857142, "no_speech_prob": 2.9626839176399855e-12}, {"id": 62, "seek": 9150, "start": 103.5, "end": 105.5, "text": " Either you know very little about AI,", "tokens": [50965, 13746, 291, 458, 588, 707, 466, 7318, 11, 51065], "temperature": 0, "avg_logprob": -0.13337318264708228, "compression_ratio": 1.7142857142857142, "no_speech_prob": 2.9626839176399855e-12}, {"id": 63, "seek": 9150, "start": 105.5, "end": 106.5, "text": " but you're hearing all the hype,", "tokens": [51065, 457, 291, 434, 4763, 439, 264, 24144, 11, 51115], "temperature": 0, "avg_logprob": -0.13337318264708228, "compression_ratio": 1.7142857142857142, "no_speech_prob": 2.9626839176399855e-12}, {"id": 64, "seek": 9150, "start": 106.5, "end": 108.5, "text": " and you want to learn about it,", "tokens": [51115, 293, 291, 528, 281, 1466, 466, 309, 11, 51215], "temperature": 0, "avg_logprob": -0.13337318264708228, "compression_ratio": 1.7142857142857142, "no_speech_prob": 2.9626839176399855e-12}, {"id": 65, "seek": 9150, "start": 109.5, "end": 111.5, "text": " or you've started to use it,", "tokens": [51265, 420, 291, 600, 1409, 281, 764, 309, 11, 51365], "temperature": 0, "avg_logprob": -0.13337318264708228, "compression_ratio": 1.7142857142857142, "no_speech_prob": 2.9626839176399855e-12}, {"id": 66, "seek": 9150, "start": 111.5, "end": 112.5, "text": " but it's very basic.", "tokens": [51365, 457, 309, 311, 588, 3875, 13, 51415], "temperature": 0, "avg_logprob": -0.13337318264708228, "compression_ratio": 1.7142857142857142, "no_speech_prob": 2.9626839176399855e-12}, {"id": 67, "seek": 9150, "start": 112.5, "end": 114.5, "text": " It's like a chat GPT,", "tokens": [51415, 467, 311, 411, 257, 5081, 26039, 51, 11, 51515], "temperature": 0, "avg_logprob": -0.13337318264708228, "compression_ratio": 1.7142857142857142, "no_speech_prob": 2.9626839176399855e-12}, {"id": 68, "seek": 9150, "start": 114.5, "end": 115.5, "text": " one prompt in,", "tokens": [51515, 472, 12391, 294, 11, 51565], "temperature": 0, "avg_logprob": -0.13337318264708228, "compression_ratio": 1.7142857142857142, "no_speech_prob": 2.9626839176399855e-12}, {"id": 69, "seek": 9150, "start": 115.5, "end": 116.5, "text": " you get one output,", "tokens": [51565, 291, 483, 472, 5598, 11, 51615], "temperature": 0, "avg_logprob": -0.13337318264708228, "compression_ratio": 1.7142857142857142, "no_speech_prob": 2.9626839176399855e-12}, {"id": 70, "seek": 9150, "start": 116.5, "end": 117.5, "text": " and you want to really learn", "tokens": [51615, 293, 291, 528, 281, 534, 1466, 51665], "temperature": 0, "avg_logprob": -0.13337318264708228, "compression_ratio": 1.7142857142857142, "no_speech_prob": 2.9626839176399855e-12}, {"id": 71, "seek": 9150, "start": 117.5, "end": 119.5, "text": " how to build systems around it", "tokens": [51665, 577, 281, 1322, 3652, 926, 309, 51765], "temperature": 0, "avg_logprob": -0.13337318264708228, "compression_ratio": 1.7142857142857142, "no_speech_prob": 2.9626839176399855e-12}, {"id": 72, "seek": 9150, "start": 119.5, "end": 120.5, "text": " and how powerful AI can be.", "tokens": [51765, 293, 577, 4005, 7318, 393, 312, 13, 51815], "temperature": 0, "avg_logprob": -0.13337318264708228, "compression_ratio": 1.7142857142857142, "no_speech_prob": 2.9626839176399855e-12}, {"id": 73, "seek": 12050, "start": 120.5, "end": 123.5, "text": " from all this hype that you're hearing,", "tokens": [50365, 490, 439, 341, 24144, 300, 291, 434, 4763, 11, 50515], "temperature": 0, "avg_logprob": -0.0909708861646981, "compression_ratio": 1.61003861003861, "no_speech_prob": 1.4105118982532527e-12}, {"id": 74, "seek": 12050, "start": 123.5, "end": 125.5, "text": " but you don't have a strategic plan", "tokens": [50515, 457, 291, 500, 380, 362, 257, 10924, 1393, 50615], "temperature": 0, "avg_logprob": -0.0909708861646981, "compression_ratio": 1.61003861003861, "no_speech_prob": 1.4105118982532527e-12}, {"id": 75, "seek": 12050, "start": 125.5, "end": 127.5, "text": " to learn about it,", "tokens": [50615, 281, 1466, 466, 309, 11, 50715], "temperature": 0, "avg_logprob": -0.0909708861646981, "compression_ratio": 1.61003861003861, "no_speech_prob": 1.4105118982532527e-12}, {"id": 76, "seek": 12050, "start": 127.5, "end": 129.5, "text": " or a process to implement it", "tokens": [50715, 420, 257, 1399, 281, 4445, 309, 50815], "temperature": 0, "avg_logprob": -0.0909708861646981, "compression_ratio": 1.61003861003861, "no_speech_prob": 1.4105118982532527e-12}, {"id": 77, "seek": 12050, "start": 129.5, "end": 130.5, "text": " into your business.", "tokens": [50815, 666, 428, 1606, 13, 50865], "temperature": 0, "avg_logprob": -0.0909708861646981, "compression_ratio": 1.61003861003861, "no_speech_prob": 1.4105118982532527e-12}, {"id": 78, "seek": 12050, "start": 132.5, "end": 133.5, "text": " That's where this course comes in.", "tokens": [50965, 663, 311, 689, 341, 1164, 1487, 294, 13, 51015], "temperature": 0, "avg_logprob": -0.0909708861646981, "compression_ratio": 1.61003861003861, "no_speech_prob": 1.4105118982532527e-12}, {"id": 79, "seek": 12050, "start": 133.5, "end": 135.5, "text": " I'm going to break it down into three parts.", "tokens": [51015, 286, 478, 516, 281, 1821, 309, 760, 666, 1045, 3166, 13, 51115], "temperature": 0, "avg_logprob": -0.0909708861646981, "compression_ratio": 1.61003861003861, "no_speech_prob": 1.4105118982532527e-12}, {"id": 80, "seek": 12050, "start": 136.5, "end": 138.5, "text": " The first part being the foundation.", "tokens": [51165, 440, 700, 644, 885, 264, 7030, 13, 51265], "temperature": 0, "avg_logprob": -0.0909708861646981, "compression_ratio": 1.61003861003861, "no_speech_prob": 1.4105118982532527e-12}, {"id": 81, "seek": 12050, "start": 138.5, "end": 140.5, "text": " Automating your grind.", "tokens": [51265, 24619, 990, 428, 16700, 13, 51365], "temperature": 0, "avg_logprob": -0.0909708861646981, "compression_ratio": 1.61003861003861, "no_speech_prob": 1.4105118982532527e-12}, {"id": 82, "seek": 12050, "start": 140.5, "end": 142.5, "text": " That is repetitive tasks,", "tokens": [51365, 663, 307, 29404, 9608, 11, 51465], "temperature": 0, "avg_logprob": -0.0909708861646981, "compression_ratio": 1.61003861003861, "no_speech_prob": 1.4105118982532527e-12}, {"id": 83, "seek": 12050, "start": 142.5, "end": 144.5, "text": " things that are very time consuming.", "tokens": [51465, 721, 300, 366, 588, 565, 19867, 13, 51565], "temperature": 0, "avg_logprob": -0.0909708861646981, "compression_ratio": 1.61003861003861, "no_speech_prob": 1.4105118982532527e-12}, {"id": 84, "seek": 12050, "start": 144.5, "end": 147.5, "text": " You can actually create workflows and systems", "tokens": [51565, 509, 393, 767, 1884, 43461, 293, 3652, 51715], "temperature": 0, "avg_logprob": -0.0909708861646981, "compression_ratio": 1.61003861003861, "no_speech_prob": 1.4105118982532527e-12}, {"id": 85, "seek": 12050, "start": 147.5, "end": 149.5, "text": " that buy back your time,", "tokens": [51715, 300, 2256, 646, 428, 565, 11, 51815], "temperature": 0, "avg_logprob": -0.0909708861646981, "compression_ratio": 1.61003861003861, "no_speech_prob": 1.4105118982532527e-12}, {"id": 86, "seek": 14950, "start": 149.5, "end": 152.5, "text": " sometimes hours and hours of your time,", "tokens": [50365, 2171, 2496, 293, 2496, 295, 428, 565, 11, 50515], "temperature": 0, "avg_logprob": -0.11828772629363628, "compression_ratio": 1.5561497326203209, "no_speech_prob": 1.9201105549288e-12}, {"id": 87, "seek": 14950, "start": 152.5, "end": 154.5, "text": " that you lose every single week.", "tokens": [50515, 300, 291, 3624, 633, 2167, 1243, 13, 50615], "temperature": 0, "avg_logprob": -0.11828772629363628, "compression_ratio": 1.5561497326203209, "no_speech_prob": 1.9201105549288e-12}, {"id": 88, "seek": 14950, "start": 154.5, "end": 155.5, "text": " You can automate that.", "tokens": [50615, 509, 393, 31605, 300, 13, 50665], "temperature": 0, "avg_logprob": -0.11828772629363628, "compression_ratio": 1.5561497326203209, "no_speech_prob": 1.9201105549288e-12}, {"id": 89, "seek": 14950, "start": 155.5, "end": 156.5, "text": " I'm going to teach you how to do that.", "tokens": [50665, 286, 478, 516, 281, 2924, 291, 577, 281, 360, 300, 13, 50715], "temperature": 0, "avg_logprob": -0.11828772629363628, "compression_ratio": 1.5561497326203209, "no_speech_prob": 1.9201105549288e-12}, {"id": 90, "seek": 14950, "start": 156.5, "end": 158.5, "text": " The second part is connecting the dots.", "tokens": [50715, 440, 1150, 644, 307, 11015, 264, 15026, 13, 50815], "temperature": 0, "avg_logprob": -0.11828772629363628, "compression_ratio": 1.5561497326203209, "no_speech_prob": 1.9201105549288e-12}, {"id": 91, "seek": 14950, "start": 158.5, "end": 162.5, "text": " Not just automating simple tasks or a single workflow,", "tokens": [50815, 1726, 445, 3553, 990, 2199, 9608, 420, 257, 2167, 20993, 11, 51015], "temperature": 0, "avg_logprob": -0.11828772629363628, "compression_ratio": 1.5561497326203209, "no_speech_prob": 1.9201105549288e-12}, {"id": 92, "seek": 14950, "start": 162.5, "end": 167.5, "text": " but having a system in place to where it does multiple tasks,", "tokens": [51015, 457, 1419, 257, 1185, 294, 1081, 281, 689, 309, 775, 3866, 9608, 11, 51265], "temperature": 0, "avg_logprob": -0.11828772629363628, "compression_ratio": 1.5561497326203209, "no_speech_prob": 1.9201105549288e-12}, {"id": 93, "seek": 16750, "start": 167.5, "end": 172.5, "text": " to where you can have like an SDR prep a meeting for sales agents,", "tokens": [50365, 281, 689, 291, 393, 362, 411, 364, 318, 9301, 2666, 257, 3440, 337, 5763, 12554, 11, 50615], "temperature": 0, "avg_logprob": -0.19161244801112584, "compression_ratio": 1.4768211920529801, "no_speech_prob": 2.332314679928671e-12}, {"id": 94, "seek": 16750, "start": 172.5, "end": 177.5, "text": " or you can synthesize large amounts of data for your marketing team,", "tokens": [50615, 420, 291, 393, 26617, 1125, 2416, 11663, 295, 1412, 337, 428, 6370, 1469, 11, 50865], "temperature": 0, "avg_logprob": -0.19161244801112584, "compression_ratio": 1.4768211920529801, "no_speech_prob": 2.332314679928671e-12}, {"id": 95, "seek": 16750, "start": 177.5, "end": 180.5, "text": " and have AI driven results,", "tokens": [50865, 293, 362, 7318, 9555, 3542, 11, 51015], "temperature": 0, "avg_logprob": -0.19161244801112584, "compression_ratio": 1.4768211920529801, "no_speech_prob": 2.332314679928671e-12}, {"id": 96, "seek": 16750, "s